{
 "_doc": "Layout family of every effect and core scene: what SHAPE the information takes on screen (not how glyphs appear). Read by scripts/h9/forms.py for the form-repeat / slogan-share / form-variety checks in review.py --video and brief.py check. A new effect: add one line under fx; a style's own scenes go under style_scenes.<style id>. An effect missing here is a warning, not an error.",
 "families": {
  "slogan":    "全屏大字 · one phrase centred full-frame (most text effects)",
  "beside":    "贴人排版 · text / numbers laid out beside the subject (presenter, host, name strap)",
  "number":    "大数字 · one figure as the picture",
  "chart":     "数据图 · bars, lines, rings, tables",
  "metaphor":  "视觉比喻 · the number made physical (units, seats, dials, swarms)",
  "compare":   "对比 · before / after, A vs B, stamps",
  "structure": "结构 · steps, lists, rankings, trees",
  "card":      "信息卡 · a designed card or genre page (key info, deal, news, action page)",
  "ui":        "界面 / 屏幕 · app UI, chat, screens, code, logs",
  "doc":       "文档 / 引用 · papers, articles, posts, documents",
  "people":    "人物 · profiles, dialogue, interviews, relations",
  "footage":   "实拍 · one clip or still as the picture",
  "photo":     "照片处理 · a photo worked over (parallax, callout, halftone)",
  "montage":   "快切 / 拼墙 · many pictures at once or in quick succession",
  "map":       "地图",
  "shape":     "图形动效 · abstract shape animation",
  "annotate":  "标注 · marks drawn over something (scribble, strike-through)",
  "breather":  "呼吸页 · pauses, chapter cards, suspense"
